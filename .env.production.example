# .env.production.example
# Copia este archivo a .env en producción y actualiza los valores

APP_NAME="E-Commerce"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://tudominio.com

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=ecommerce_prod
DB_USERNAME=usuario_produccion
DB_PASSWORD=contraseña_fuerte_aqui

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=tu_email@gmail.com
MAIL_PASSWORD=contraseña_app_gmail

# Despliegue en Render.com
# Estas variables se configuran en el dashboard de Render
# No incluir credenciales reales aquí
